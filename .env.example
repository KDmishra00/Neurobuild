# ═══════════════════════════════════════════
# LOCAL DEVELOPMENT
# ═══════════════════════════════════════════

# Server
PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
MONGODB_URI=mongodb://localhost:27017/neurobuild

# Local generation (install and run Ollama, then pull a model)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma:latest
PIPELINE_ENABLED=true
PIPELINE_MODEL_GENERATOR=gemma:latest
PIPELINE_MODEL_REFINER=gemma:latest

# Optional: OpenRouter-compatible cloud generation
# CLOUD_API_KEY=your-openrouter-key
# CLOUD_API_URL=https://openrouter.ai/api/v1/chat/completions

# Optional: Groq cloud generation (ultra-fast inference)
# GROQ_API_KEY=your-groq-api-key
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Optional: Direct OpenAI generation (GPT-4o, GPT-4o-mini)
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# Optional: OpenAI GPT-6 Astra via Experiential Labs Gateway
# ASTRA_API_KEY=your-experiential-labs-api-key
# ASTRA_API_URL=https://api.experientiallabs.ai/v1/chat/completions

# Comma-separated public origins, only used when NODE_ENV=production
# ALLOWED_ORIGINS=https://your-domain.example

# ═══════════════════════════════════════════
# PRODUCTION (Vercel + MongoDB Atlas)
# Set these in the Vercel Dashboard → Settings → Environment Variables
# ═══════════════════════════════════════════
#
# NODE_ENV=production
# JWT_SECRET=<generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))">
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/neurobuild?retryWrites=true&w=majority
# CLOUD_API_KEY=<your OpenRouter or NVIDIA API key>
# CLOUD_API_URL=https://openrouter.ai/api/v1/chat/completions
# ALLOWED_ORIGINS=https://your-app.vercel.app
#
# NOTE: Ollama (local models) won't be available on Vercel.
# Production must use a cloud AI provider (OpenRouter, NVIDIA NIM, etc.)
