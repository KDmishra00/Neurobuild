# ═══════════════════════════════════════════
# LOCAL DEVELOPMENT
# ═══════════════════════════════════════════

# Server
PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
MONGODB_URI=mongodb://localhost:27017/neurobuild

# Local generation (install and run Ollama, then pull a model)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
PIPELINE_ENABLED=true
PIPELINE_MODEL_GENERATOR=qwen2.5-coder:7b
PIPELINE_MODEL_REFINER=qwen2.5-coder:7b

# Optional: OpenRouter-compatible cloud generation
# CLOUD_API_KEY=your-openrouter-key
# CLOUD_API_URL=https://openrouter.ai/api/v1/chat/completions

# Optional: Groq cloud generation (ultra-fast - GPT-OSS 120B/20B, Qwen 3.8 27B)
# GROQ_API_KEY=your-groq-api-key
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Optional: NVIDIA NIM cloud generation
# NVIDIA_API_KEY=your-nvidia-api-key
# NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Optional: Moonshot AI (Kimi) generation
# MOONSHOT_API_KEY=your-moonshot-api-key

# Optional: Direct OpenAI generation (GPT-4o, GPT-4o-mini)
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# Optional: OpenAI GPT-6 Astra / Sol / Luna via Experiential Labs Gateway
# ASTRA_API_KEY=your-experiential-labs-api-key
# ASTRA_API_URL=https://api.experientiallabs.ai/v1/chat/completions

# Comma-separated public origins, only used when NODE_ENV=production
# ALLOWED_ORIGINS=https://your-domain.example

# ═══════════════════════════════════════════
# PRODUCTION (Vercel + MongoDB Atlas)
# Set ALL of these in Vercel Dashboard -> Settings -> Environment Variables
# ═══════════════════════════════════════════
#
# NODE_ENV=production
# JWT_SECRET=<node -e "console.log(require('crypto').randomBytes(64).toString('hex'))">
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/neurobuild
# ALLOWED_ORIGINS=https://your-app.vercel.app
#
# At least one cloud AI provider is required on Vercel (Ollama is local-only):
# ASTRA_API_KEY=xpl_...         <- Experiential Labs (GPT-6 Astra/Sol/Luna)
# GROQ_API_KEY=gsk_...          <- Groq (GPT-OSS 120B/20B, Qwen 3.8 27B)
# CLOUD_API_KEY=sk-or-v1-...   <- OpenRouter (many models)
# NVIDIA_API_KEY=nvapi-...      <- NVIDIA NIM
# OPENAI_API_KEY=sk-...         <- Direct OpenAI

