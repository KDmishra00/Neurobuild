{
  "version": 2,
  "buildCommand": "npm --prefix client install && npm --prefix client run build:vercel",
  "installCommand": "npm install",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}