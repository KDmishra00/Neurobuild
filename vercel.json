{
  "version": 2,
  "buildCommand": "npm --prefix client install && npm --prefix client run build",
  "installCommand": "npm install",
  "functions": {
    "api/index.js": {
      "includeFiles": "client/dist/**",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.js" }
  ]
}