{
  "version": 2,
  "buildCommand": "npm --prefix client install && npm --prefix client run build",
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "client/dist/**",
          "middleware/**",
          "models/**",
          "routes/**",
          "services/**",
          "frontend/**",
          "public/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}